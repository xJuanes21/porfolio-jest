---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import StageNav from '../../components/StageNav.astro';
import Hero from '../../components/Hero.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import BentoSkills from '../../components/BentoSkills.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  lang="en"
  title="Juan Esteban Salazar | Frontend Engineer & Interface Architect"
  description="Portfolio of Juan Esteban Salazar Toro. Frontend Engineer specialized in React 19, Next.js, TypeScript, modular architectures, and tactile GSAP interfaces."
>
  <Navbar lang="en" />
  <StageNav lang="en" />

  <main class="relative">
    <!-- Stage 1: Hero -->
    <Hero lang="en" />

    <!-- Stage 2: Experience -->
    <Experience lang="en" />

    <!-- Stage 3: Work / Projects -->
    <Projects lang="en" />

    <!-- Stage 4: Education & Architecture -->
    <BentoSkills lang="en" />

    <!-- Stage 5: Contact -->
    <Contact lang="en" />
  </main>

  <Footer lang="en" />
</Layout>

<script>
  import { initPortfolioAnimations } from '../../scripts/animations';
  initPortfolioAnimations();
</script>
