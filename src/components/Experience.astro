---
import UnifiedCarousel from './UnifiedCarousel.astro';
import { getI18n } from '../i18n/utils';

export interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = getI18n(lang).experience;
const experiences = t.items;
---

<section id="experience" style="background-color: #040d1a;" class="stage-layer py-28 px-4 md:px-8 relative overflow-x-clip">
  <div class="max-w-5xl mx-auto w-full z-10 relative">
    
    <!-- Kinetic Section Divider -->
    <div class="section-divider mb-12"></div>

    <!-- Section Header -->
    <div class="mb-14">
      <span class="font-mono text-xs text-sky-400/90 tracking-wider uppercase block mb-2">
        {t.headerSub}
      </span>
      <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.025em] text-white mb-3">
        <span class="mask-reveal">
          <span class="mask-reveal-inner">{t.headerTitle}</span>
        </span>
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl leading-relaxed">
        {t.headerDesc}
      </p>
    </div>

    <!-- Experience Carousel -->
    <div>
      <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider block mb-8">
        {lang === 'en' ? 'Career Timeline' : 'Historial de Roles'}
      </span>

      <UnifiedCarousel itemsVisibleDesktop={1} autoPlay={false}>
        {experiences.map((exp: any) => (
          <div class="exp-card relative rounded-2xl overflow-hidden border border-white/[0.07] bg-[#07111f]">

            <!-- Top accent line -->
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-sky-400/40 to-transparent"></div>

            <div class="flex flex-col md:flex-row min-h-[360px]">

              <!-- LEFT: Logo slab -->
              <div class="md:w-52 lg:w-60 shrink-0 flex flex-col items-center justify-center gap-5 p-8 bg-white/[0.02] border-b md:border-b-0 md:border-r border-white/[0.06] relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-sky-400/[0.04] to-transparent pointer-events-none"></div>

                {exp.logo ? (
                  <div class="relative z-10 w-24 h-24 flex items-center justify-center">
                    <img
                      src={exp.logo}
                      alt={exp.company}
                      class="w-full h-full object-contain"
                      style="filter: drop-shadow(0 0 20px rgba(56,189,248,0.18));"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="relative z-10 w-24 h-24 rounded-2xl bg-zinc-900 border border-white/[0.08] flex items-center justify-center">
                    <span class="font-mono font-bold text-3xl text-zinc-400">FL</span>
                  </div>
                )}

                <div class="relative z-10 text-center space-y-1">
                  <span class="text-sm font-semibold text-white block leading-tight">{exp.company}</span>
                  <span class="text-[11px] font-mono text-zinc-500 block">{exp.period}</span>
                </div>

                <span class="relative z-10 text-[10px] font-mono text-sky-400/70 border border-sky-400/15 bg-sky-400/5 px-2.5 py-1 rounded-full text-center">
                  {exp.scope}
                </span>
              </div>

              <!-- RIGHT: Content -->
              <div class="flex-1 p-7 sm:p-8 flex flex-col gap-5">

                <!-- Role heading -->
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                  <div>
                    <h3 class="text-xl sm:text-2xl font-semibold text-white tracking-tight leading-snug">
                      {exp.role}
                    </h3>
                    <div class="flex items-center gap-1.5 mt-1">
                      <span class="text-zinc-600 font-mono text-xs">@</span>
                      <span class="text-sm text-zinc-400 font-medium">{exp.company}</span>
                    </div>
                  </div>
                  <span class="shrink-0 font-mono text-xs text-zinc-400 bg-zinc-900/80 border border-white/[0.07] px-3 py-1.5 rounded-full self-start">
                    {exp.period}
                  </span>
                </div>

                <div class="h-px bg-gradient-to-r from-white/[0.06] to-transparent"></div>

                <!-- Description -->
                <p class="text-sm text-zinc-400 leading-[1.75]">{exp.description}</p>

                <!-- Challenges -->
                <div class="space-y-2.5 flex-grow">
                  <span class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.12em] block">
                    {lang === 'en' ? 'Technical Challenges' : 'Retos Técnicos'}
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    {exp.challenges.map((c: any) => (
                      <div class="flex items-start gap-2.5 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] hover:border-white/[0.09] hover:bg-white/[0.04] transition-colors duration-150">
                        <span class="shrink-0 mt-0.5 text-sky-400/50 font-mono text-xs font-bold leading-none">→</span>
                        <div class="min-w-0">
                          <span class="font-mono text-[11px] font-semibold text-zinc-200 block mb-0.5">{c.title}</span>
                          <span class="text-[11px] text-zinc-500 leading-relaxed block">{c.detail}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Stack -->
                <div class="flex flex-wrap gap-1.5 mt-auto pt-1">
                  {exp.stack.map((item: string) => (
                    <span class="px-2.5 py-1 rounded-md bg-zinc-900/80 border border-white/[0.05] text-[11px] font-mono text-zinc-400">
                      {item}
                    </span>
                  ))}
                </div>

              </div>
            </div>
          </div>
        ))}
      </UnifiedCarousel>
    </div>

  </div>
</section>

<style>
  .exp-card {
    transition: border-color 200ms cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow   200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .exp-card:hover {
      border-color: rgba(255, 255, 255, 0.11);
      box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.06),
                  0 24px 48px -16px rgba(0, 0, 0, 0.7);
    }
  }
</style>
