---
export interface Props {
  currentLang?: 'es' | 'en';
  className?: string;
}

const { currentLang = 'es', className = '' } = Astro.props;
---

<div
  id="fixed-lang-toggle"
  class={`fixed bottom-6 right-6 z-50 select-none ${className}`}
  role="region"
  aria-label="Selector de idioma / Language Switcher"
>
  <div
    class="flex items-center gap-1.5 p-1 rounded-full border border-white/10 bg-zinc-950/80 backdrop-blur-xl shadow-2xl shadow-black/60 hover:border-white/20 transition-all duration-300 inner-bevel"
  >
    <!-- Globe Icon -->
    <div class="pl-2 pr-1 text-zinc-400" aria-hidden="true">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
        />
      </svg>
    </div>

    <!-- Spanish Switch -->
    <a
      href="/"
      data-lang="es"
      class={`lang-btn relative px-2.5 py-1 text-xs font-mono font-medium rounded-full transition-all duration-200 cursor-pointer ${
        currentLang === 'es'
          ? 'bg-sky-400 text-zinc-950 shadow-sm font-semibold'
          : 'text-zinc-400 hover:text-white'
      }`}
      aria-label="Cambiar a Español"
      aria-current={currentLang === 'es' ? 'true' : 'false'}
    >
      ES
    </a>

    <!-- Divider -->
    <span class="text-zinc-700 text-xs font-mono select-none" aria-hidden="true">/</span>

    <!-- English Switch -->
    <a
      href="/en"
      data-lang="en"
      class={`lang-btn relative px-2.5 py-1 text-xs font-mono font-medium rounded-full transition-all duration-200 cursor-pointer ${
        currentLang === 'en'
          ? 'bg-sky-400 text-zinc-950 shadow-sm font-semibold'
          : 'text-zinc-400 hover:text-white'
      }`}
      aria-label="Switch to English"
      aria-current={currentLang === 'en' ? 'true' : 'false'}
    >
      EN
    </a>
  </div>
</div>

<script>
  // Ensure hash (e.g. #projects) is preserved when toggling language
  const setupLanguageSwitchers = () => {
    document.querySelectorAll<HTMLAnchorElement>('.lang-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetLang = btn.getAttribute('data-lang');
        const hash = window.location.hash || '';
        if (targetLang) {
          localStorage.setItem('portfolio_pref_lang', targetLang);
        }
        
        // If clicking same language, do nothing
        const isCurrent = btn.getAttribute('aria-current') === 'true';
        if (isCurrent) {
          e.preventDefault();
          return;
        }

        e.preventDefault();
        const base = targetLang === 'en' ? '/en' : '/';
        window.location.href = `${base}${hash}`;
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLanguageSwitchers);
  } else {
    setupLanguageSwitchers();
  }
</script>
