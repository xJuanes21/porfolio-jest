---
interface Props {
  className?: string;
}
---

<header class="fixed top-5 left-0 right-0 z-50 flex justify-center px-4">
  <nav
    class="flex items-center justify-between gap-4 sm:gap-6 px-4 sm:px-5 py-2.5 rounded-full border border-white/[0.08] bg-zinc-950/80 backdrop-blur-xl shadow-2xl shadow-black/40 max-w-3xl w-full inner-bevel"
  >
    <!-- Brand Logo Monogram -->
    <a
      href="#hero"
      class="group flex items-center gap-2.5 text-xs sm:text-sm font-semibold tracking-tight text-white focus:outline-none"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-full bg-zinc-900 border border-white/10 text-white text-[11px] font-mono font-medium group-hover:border-white/25 transition-colors"
      >
        JS
      </span>
      <span
        class="hidden sm:inline-block text-zinc-200 group-hover:text-white transition-colors"
      >
        Juan Salazar<span class="text-zinc-500 font-mono text-xs">.dev</span>
      </span>
    </a>

    <!-- Status & Action -->
    <div class="flex items-center gap-2.5">
      <!-- Quick Tactile CTA -->
      <a
        href="#contact"
        class="tactile-btn hidden sm:inline-flex px-3.5 py-1.5 text-xs font-medium rounded-full bg-zinc-100 text-zinc-950 hover:bg-white transition-colors shadow-sm"
      >
        Hablemos
      </a>
    </div>
  </nav>
</header>
