---
import { getI18n } from "../i18n/utils";

export interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getI18n(lang).projects;
const en = lang === "en";

type Accent = "rose" | "violet" | "sky" | "emerald" | "amber" | "blue" | "teal";

interface Tile {
  id: number;
  // full = texto + métricas (+ mockup en MIS-BS) · cover = imagen a sangre · stats / cta = tiles de relleno
  variant: "full" | "cover" | "stats" | "cta";
  span: string; // Tailwind grid span (col + row)
  accent: Accent;
  slug?: string;
  title?: string;
  category?: string;
  description?: string;
  badge?: string;
  stack?: string[];
  url?: string;
  domain?: string;
  image?: string;
  isPrivate?: boolean;
  privacyNotice?: string;
  metrics?: { label: string; value: string }[];
}

const item = (i: number) => t.items[i];

const tiles: Tile[] = [
  {
    id: 1,
    variant: "full",
    span: "col-span-12 lg:col-span-8 lg:row-span-2",
    accent: "rose",
    slug: "mis-bs",
    title: item(0)?.title || "Sistema MIS-BS — Banco de Sangre HUV",
    category: item(0)?.category || "Salud & Trazabilidad Digital",
    description: item(0)?.description || "Solución digital para optimizar procesos físicos del Banco de Sangre en el HUV.",
    badge: item(0)?.badge || "Sistema Clínico HUV",
    stack: ["PHP Backend", "React", "Vite", "TypeScript", "Tailwind CSS", "REST API"],
    isPrivate: true,
    privacyNotice: item(0)?.privacyNotice || t.privateDisclaimer,
    metrics: [
      { label: en ? "Digital Traceability" : "Trazabilidad Digital", value: "100%" },
      { label: en ? "Paper Elimination" : "Reducción Papel", value: "−90%" },
      { label: en ? "Validation Speed" : "Tiempo Registro", value: "< 2 min" },
    ],
  },
  {
    id: 2,
    variant: "full",
    span: "col-span-12 md:col-span-6 lg:col-span-4",
    accent: "violet",
    slug: "fitbrandly",
    title: item(1)?.title || "FitBrandly — White Label Application",
    category: item(1)?.category || "SaaS / Fitness Tech",
    description: item(1)?.description || "Plataforma web white-label para gestión y venta de productos digitales y asesorías.",
    badge: item(1)?.badge || "Plataforma SaaS",
    stack: ["React", "Next.js", "Tailwind CSS", "TypeScript"],
    domain: "app.fitbrandly.com",
  },
  { id: 100, variant: "stats", span: "col-span-12 md:col-span-6 lg:col-span-4", accent: "sky" },
  {
    id: 3,
    variant: "cover",
    span: "col-span-12 md:col-span-6 lg:col-span-4 lg:row-span-2",
    accent: "sky",
    slug: "itw",
    title: item(2)?.title || "ITW LLC — Corporate Website",
    category: item(2)?.category || "Servicios Empresariales (EE. UU.)",
    description: item(2)?.description || "Sitio web corporativo para servicios empresariales en Estados Unidos.",
    stack: ["Astro", "React", "Tailwind CSS", "TypeScript"],
    url: "https://itwllc.us",
    domain: "itwllc.us",
    image: "/assets/heros/itwllc-hero.png",
  },
  {
    id: 4,
    variant: "cover",
    span: "col-span-12 md:col-span-6 lg:col-span-4 lg:row-span-2",
    accent: "emerald",
    slug: "colombo",
    title: item(3)?.title || "Colombo Farmacéutica — Corporate Website",
    category: item(3)?.category || "Sector Farmacéutico",
    description: item(3)?.description || "Landing page corporativa para el sector farmacéutico y catálogo B2B.",
    stack: ["Next.js", "TypeScript", "Tailwind CSS"],
    url: "https://www.colombofarmaceutica.com",
    domain: "www.colombofarmaceutica.com",
    image: "/assets/heros/colombo-hero.png",
  },
  {
    id: 5,
    variant: "cover",
    span: "col-span-12 md:col-span-6 lg:col-span-4",
    accent: "amber",
    slug: "scf",
    title: item(4)?.title || "SCF — Freelance Website",
    category: item(4)?.category || "Consultoría Empresarial (Luxemburgo)",
    description: item(4)?.description || "Sitio web corporativo desarrollado como proyecto freelance para Luxemburgo.",
    stack: ["Astro", "TypeScript", "Tailwind CSS"],
    url: "https://scf.lu",
    domain: "scf.lu",
    image: "/assets/heros/scf-hero.png", // ← cambia esta ruta cuando tengas la foto
  },
  { id: 101, variant: "cta", span: "col-span-12 md:col-span-6 lg:col-span-4", accent: "teal" },
  {
    id: 6,
    variant: "cover",
    span: "col-span-12 md:col-span-6 lg:col-span-6",
    accent: "blue",
    slug: "coyman",
    title: item(5)?.title || "COYMAN PROYECTOS — Corporate Website",
    category: item(5)?.category || "Ingeniería & Obras Civiles",
    description: item(5)?.description || "Landing page corporativa para presentación empresarial de proyectos de ingeniería.",
    stack: ["React", "Vite", "Tailwind CSS"],
    url: "https://coymanproyectos.com",
    domain: "coymanproyectos.com",
    image: "/assets/heros/coyman-hero.png",
  },
  {
    id: 7,
    variant: "cover",
    span: "col-span-12 md:col-span-6 lg:col-span-6",
    accent: "teal",
    slug: "siprac",
    title: item(6)?.title || "SIPRAC — Corporate Website",
    category: item(6)?.category || "Seguridad & Soluciones Digitales",
    description: item(6)?.description || "Landing page corporativa desarrollada como solución digital empresarial.",
    stack: ["Next.js", "Tailwind CSS", "TypeScript"],
    url: "https://siprac.com",
    domain: "siprac.com",
    image: "/assets/heros/siprac-hero.png",
  },
];

const glow: Record<Accent, string> = {
  rose: "from-rose-500/20 via-rose-500/5 to-transparent",
  violet: "from-violet-500/20 via-violet-500/5 to-transparent",
  sky: "from-sky-500/20 via-sky-500/5 to-transparent",
  emerald: "from-emerald-500/20 via-emerald-500/5 to-transparent",
  amber: "from-amber-500/20 via-amber-500/5 to-transparent",
  blue: "from-blue-500/20 via-blue-500/5 to-transparent",
  teal: "from-teal-500/20 via-teal-500/5 to-transparent",
};

const stats = [
  { value: "7", label: en ? "Projects shipped" : "Proyectos entregados" },
  { value: "3", label: en ? "Countries" : "Países" },
  { value: "1", label: en ? "Clinical system" : "Sistema clínico" },
];

const tileBase =
  "craft-card spotlight-card group relative rounded-3xl border border-white/[0.08] hover:border-white/20 bg-zinc-950/70 overflow-hidden transition-colors duration-300 inner-bevel";
---

<section
  id="projects"
  class="stage-layer py-24 sm:py-28 px-4 md:px-8 relative overflow-x-clip"
  style="background-color: #050505;"
>
  <div class="max-w-6xl mx-auto w-full z-10 relative">
    <div class="section-divider mb-12"></div>

    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <span class="font-mono text-xs text-sky-400/90 tracking-wider uppercase block mb-2">{t.headerSub}</span>
        <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.025em] text-white">
          <span class="mask-reveal"><span class="mask-reveal-inner">{t.headerTitle}</span></span>
        </h2>
      </div>
      <p class="text-zinc-400 text-sm max-w-md leading-relaxed">{t.headerDesc}</p>
    </div>

    <!-- ══ BENTO: 12 cols, filas de 240px, tiles de 1 o 2 filas ═════════════ -->
    <div
      id="bento-grid"
      class="grid grid-cols-12 gap-3 sm:gap-4 auto-rows-[minmax(240px,auto)] lg:grid-flow-row-dense"
    >
      {
        tiles.map((tile) => (
          <>
            {/* ── FULL: texto + métricas (+ mockup en MIS-BS) ── */}
            {tile.variant === "full" && (
              <article class={`${tileBase} ${tile.span} flex flex-col justify-between p-6 sm:p-8`} data-bento-card>
                <div class={`pointer-events-none absolute -top-24 -right-24 h-56 w-56 rounded-full bg-gradient-to-br ${glow[tile.accent]} blur-3xl opacity-40 group-hover:opacity-80 transition-opacity duration-500`} />
                <div class="relative z-10 flex flex-col h-full justify-between gap-5">
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                      <div class="flex items-center gap-2">
                        <span class={`h-2 w-2 rounded-full ${tile.isPrivate ? "bg-rose-400" : "bg-emerald-400"} animate-pulse`} />
                        <span class="text-xs font-mono text-zinc-400 tracking-wide uppercase">{tile.category}</span>
                      </div>
                      <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-white/[0.05] border border-white/10 text-zinc-300">
                        {tile.domain || tile.badge}
                      </span>
                    </div>
                    <h3 class={`${tile.id === 1 ? "text-2xl sm:text-3xl" : "text-lg sm:text-xl"} font-semibold text-white tracking-tight leading-snug mb-2.5`}>
                      {tile.title}
                    </h3>
                    <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed max-w-xl">{tile.description}</p>

                    {tile.isPrivate && (
                      <div class="mt-4 p-3 rounded-2xl bg-rose-950/30 border border-rose-500/20 text-rose-200/90 text-xs font-mono leading-relaxed flex items-start gap-2.5">
                        <svg class="w-4 h-4 text-rose-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                        <span>{tile.privacyNotice}</span>
                      </div>
                    )}
                  </div>

                  {tile.metrics && (
                    <div class="grid grid-cols-3 gap-3 p-3.5 rounded-2xl bg-zinc-900/50 border border-white/[0.06]">
                      {tile.metrics.map((m) => (
                        <div class="flex flex-col">
                          <span class="text-lg sm:text-2xl font-bold font-mono text-zinc-100 tracking-tight">{m.value}</span>
                          <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider">{m.label}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  <div class="pt-3 border-t border-white/[0.06] flex flex-wrap items-center justify-between gap-3">
                    <div class="flex flex-wrap gap-1.5">
                      {tile.stack?.map((tech) => (
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-white/[0.04] border border-white/[0.06] text-zinc-400">{tech}</span>
                      ))}
                    </div>
                    {tile.isPrivate && (
                      <span class="text-xs font-mono text-zinc-400 px-3 py-1.5 rounded-full bg-zinc-900 border border-white/10">{t.privateBadge}</span>
                    )}
                  </div>
                </div>
              </article>
            )}

            {/* ── COVER: screenshot a sangre, texto encima, descripción en hover ── */}
            {tile.variant === "cover" && (
              <article class={`${tileBase} ${tile.span} min-h-[260px]`} data-bento-card>
                <img
                  src={tile.image}
                  alt={tile.title}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                />
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/55 to-zinc-950/10" />
                <div class={`pointer-events-none absolute -top-24 -right-24 h-56 w-56 rounded-full bg-gradient-to-br ${glow[tile.accent]} blur-3xl opacity-60`} />

                {/* Link a todo el tile */}
                <a
                  href={tile.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute inset-0 z-20 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded-3xl"
                  aria-label={`${t.viewDemo} - ${tile.title}`}
                />

                <div class="relative z-10 h-full flex flex-col justify-between p-5 sm:p-6 pointer-events-none">
                  <div class="flex items-start justify-between gap-3">
                    <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-zinc-950/70 backdrop-blur-md border border-white/10 text-zinc-300">
                      {tile.domain}
                    </span>
                    <span class="w-8 h-8 rounded-full bg-white text-zinc-950 flex items-center justify-center opacity-0 -translate-x-2 translate-y-2 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </span>
                  </div>

                  <div>
                    <span class="text-[11px] font-mono text-zinc-400 tracking-wide uppercase">{tile.category}</span>
                    <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug mt-1">{tile.title}</h3>
                    <p class="text-zinc-300 text-xs sm:text-sm leading-relaxed overflow-hidden transition-all duration-500 ease-out mt-0 max-h-24 opacity-100 lg:max-h-0 lg:opacity-0 lg:group-hover:max-h-24 lg:group-hover:opacity-100 lg:group-hover:mt-2">
                      {tile.description}
                    </p>
                    <div class="flex flex-wrap gap-1.5 mt-3">
                      {tile.stack?.map((tech) => (
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-zinc-950/60 backdrop-blur-md border border-white/10 text-zinc-300">{tech}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </article>
            )}

            {/* ── STATS: tile de relleno con números ── */}
            {tile.variant === "stats" && (
              <article class={`${tileBase} ${tile.span} p-6 sm:p-8 flex flex-col justify-between`} data-bento-card>
                <div class={`pointer-events-none absolute -bottom-24 -left-24 h-56 w-56 rounded-full bg-gradient-to-tr ${glow[tile.accent]} blur-3xl opacity-60`} />
                <span class="relative text-xs font-mono text-zinc-400 tracking-wide uppercase">{en ? "In numbers" : "En números"}</span>
                <div class="relative grid grid-cols-3 gap-3">
                  {stats.map((s) => (
                    <div class="flex flex-col">
                      <span class="text-4xl sm:text-5xl font-bold text-white tracking-tight">{s.value}</span>
                      <span class="text-[11px] text-zinc-400 leading-tight mt-1">{s.label}</span>
                    </div>
                  ))}
                </div>
              </article>
            )}

            {/* ── CTA: cierra el bloque y lleva a contacto ── */}
            {tile.variant === "cta" && (
              <article class={`${tileBase} ${tile.span}`} data-bento-card>
                <div class={`pointer-events-none absolute inset-0 bg-gradient-to-br ${glow[tile.accent]} opacity-70`} />
                <a
                  href="#contact"
                  class="relative z-10 h-full p-6 sm:p-8 flex flex-col justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 rounded-3xl"
                >
                  <h3 class="text-xl sm:text-2xl font-semibold text-white tracking-tight leading-snug max-w-[16ch]">
                    {en ? "Your project could be next" : "Tu proyecto puede ser el siguiente"}
                  </h3>
                  <span class="inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-950 text-xs font-mono font-medium group-hover:bg-white">
                    {en ? "Let's talk" : "Hablemos"}
                    <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17" />
                    </svg>
                  </span>
                </a>
              </article>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>