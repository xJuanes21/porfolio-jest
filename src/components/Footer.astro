---
import { getI18n } from "../i18n/utils";

export interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getI18n(lang).footer;
const currentYear = new Date().getFullYear();
---

<footer
  class="relative z-50 border-t border-white/[0.08] py-10 px-4 md:px-8 bg-[#09090b]/95 backdrop-blur-md"
>
  <div
    class="max-w-5xl mx-auto flex items-center justify-between gap-4 text-xs font-mono"
  >
    <!-- Left: Identity & Year -->
    <div class="flex items-center gap-2 text-zinc-500 text-[11px]">
      <span class="text-zinc-300 font-medium tracking-tight">
        Juan Esteban Salazar
      </span>
      <span class="text-zinc-700" aria-hidden="true">&bull;</span>
      <span class="text-zinc-400">
        &copy; {currentYear}
      </span>
    </div>

    <!-- Right: Back to Top -->
    <button
      id="footer-back-to-top"
      type="button"
      class="tactile-btn inline-flex items-center gap-1.5 text-[11px] text-zinc-400 hover:text-white transition-colors cursor-pointer py-1.5 px-3 rounded-full border border-white/10 bg-zinc-900/60 hover:border-white/20 active:scale-95"
      aria-label={t.backToTop}
    >
      <span>{t.backToTop}</span>
      <svg
        class="w-3.5 h-3.5 text-zinc-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>
  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById("footer-back-to-top");
  if (backToTopBtn) {
    backToTopBtn.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });
  }
</script>
