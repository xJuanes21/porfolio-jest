---
---

<section id="hero" class="stage-layer relative min-h-[95vh] flex items-center justify-center pt-32 pb-20 px-4 md:px-8 overflow-hidden">
  <!-- Parallax Stage Watermark -->
  <span class="stage-watermark -top-12 -left-8 select-none" aria-hidden="true">01</span>

  <div class="max-w-6xl mx-auto w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Editorial Value Proposition (Span 7) -->
      <div class="lg:col-span-7 text-left">
        
        <!-- Live Status Strip -->
        <div class="hero-badge inline-flex items-center gap-2.5 px-3 py-1 rounded-full border border-white/[0.08] bg-zinc-900/60 backdrop-blur-md text-zinc-300 text-xs font-mono mb-6 inner-bevel">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Disponible &bull; Frontend Engineer</span>
        </div>

        <!-- Masked Headline with Kinetic Reveals -->
        <div class="hero-title mb-6">
          <h1 class="text-3xl sm:text-5xl lg:text-[3.5rem] font-semibold tracking-[-0.035em] leading-[1.08] text-white">
            <span class="mask-reveal">
              <span class="mask-reveal-inner">Desarrollador Frontend</span>
            </span>
            <span class="mask-reveal">
              <span class="mask-reveal-inner text-zinc-400">& Arquitecto de Interfaces.</span>
            </span>
          </h1>
        </div>

        <!-- Bio Description -->
        <p class="hero-desc text-sm sm:text-base text-zinc-400 max-w-xl leading-relaxed mb-8">
          Soy <span class="text-zinc-100 font-medium">Juan Esteban Salazar Toro</span>. Especializado en el ecosistema <span class="text-zinc-200">React, Next.js y TypeScript</span>. Construyo aplicaciones web de alto rendimiento, micro-interacciones fluidas y herramientas aceleradas por <span class="text-zinc-200">Inteligencia Artificial</span>.
        </p>

        <!-- Actions Dock -->
        <div class="hero-cta flex flex-wrap items-center gap-3.5 mb-10">
          <a
            href="#projects"
            class="tactile-btn magnetic-btn group inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-zinc-100 text-zinc-950 font-medium text-xs sm:text-sm hover:bg-white shadow-lg transition-all"
          >
            <span>Ver Trabajo Seleccionado</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#contact"
            class="tactile-btn magnetic-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 bg-zinc-900/60 backdrop-blur-sm text-zinc-300 hover:text-white hover:bg-zinc-800 text-xs sm:text-sm font-medium transition-all"
          >
            <span>Iniciar Contacto</span>
          </a>

          <!-- Social links -->
          <div class="flex items-center gap-2 pl-2">
            <a
              href="https://github.com"
              target="_blank"
              rel="noopener noreferrer"
              class="tactile-btn p-2.5 rounded-full border border-white/[0.08] bg-zinc-900/60 text-zinc-400 hover:text-white transition-colors"
              title="GitHub"
              aria-label="GitHub de Juan Esteban"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="tactile-btn p-2.5 rounded-full border border-white/[0.08] bg-zinc-900/60 text-zinc-400 hover:text-white transition-colors"
              title="LinkedIn"
              aria-label="LinkedIn de Juan Esteban"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Technical Footnote -->
        <div class="pt-6 hairline-t flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-500">
          <span>UAO Ingeniería '26</span>
          <span>&bull;</span>
          <span>Cali, Colombia (UTC-5)</span>
          <span>&bull;</span>
          <span>Web Vitals 100%</span>
        </div>

      </div>

      <!-- Right Column: Interactive Engineering Console (Span 5) -->
      <div class="lg:col-span-5 hero-console">
        <div class="craft-card spotlight-card rounded-2xl overflow-hidden shadow-2xl border border-white/10 inner-bevel">
          
          <!-- macOS Window Titlebar -->
          <div class="px-4 py-3 bg-zinc-900/90 border-b border-white/[0.06] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="font-mono text-xs text-zinc-400 font-medium">DeveloperProfile.tsx</span>
            <span class="font-mono text-[10px] text-zinc-500">TSX</span>
          </div>

          <!-- Interactive Code Body -->
          <div class="p-5 font-mono text-xs leading-relaxed overflow-x-auto text-zinc-300">
            <div class="text-zinc-500">// Arquitectura del perfil profesional</div>
            <p class="mt-1"><span class="text-amber-400">const</span> <span class="text-zinc-100">engineer</span>: <span class="text-zinc-400">FrontendSpecialist</span> = &#123;</p>
            <div class="pl-4 space-y-1">
              <p><span class="text-zinc-400">name:</span> <span class="text-zinc-200">"Juan Esteban Salazar Toro"</span>,</p>
              <p><span class="text-zinc-400">focus:</span> [<span class="text-zinc-200">"React 19"</span>, <span class="text-zinc-200">"Next.js"</span>, <span class="text-zinc-200">"TypeScript"</span>],</p>
              <p><span class="text-zinc-400">standards:</span> [<span class="text-zinc-200">"Emil Kowalski Craft"</span>, <span class="text-zinc-200">"GSAP Motion"</span>],</p>
              <p><span class="text-zinc-400">aiIntegration:</span> <span class="text-amber-400">true</span>,</p>
              <p><span class="text-zinc-400">status:</span> <span class="text-emerald-400">"Available for high-impact work"</span></p>
            </div>
            <p>&#125;;</p>

            <!-- Interactive Terminal Telemetry -->
            <div class="mt-5 p-3.5 rounded-xl bg-black/40 border border-white/[0.06] text-[11px] text-zinc-400 space-y-2">
              <div class="flex items-center justify-between text-zinc-300">
                <span class="text-zinc-500">Telemetry Status:</span>
                <span class="text-emerald-400 flex items-center gap-1.5 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Ready to deploy
                </span>
              </div>
              <div class="flex justify-between text-zinc-500">
                <span>Core Web Vitals:</span>
                <span class="text-zinc-300 font-semibold">99.8% Perf</span>
              </div>
              <div class="flex justify-between text-zinc-500">
                <span>Component Fidelity:</span>
                <span class="text-zinc-300 font-semibold">Production-Grade</span>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
