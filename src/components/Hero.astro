---
import { getI18n } from "../i18n/utils";

export interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getI18n(lang).hero;
---

<section
  id="hero"
  class="stage-layer relative min-h-[95vh] flex items-center justify-center pt-32 pb-20 px-4 md:px-8 overflow-hidden"
  style="background-color: #020202;"
>
  <div class="max-w-6xl mx-auto w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Editorial Value Proposition (Span 7) -->
      <div class="lg:col-span-7 text-left">
        <!-- Live Status Strip -->
        <div
          class="hero-badge inline-flex items-center gap-2.5 px-3 py-1 rounded-full border border-white/[0.08] bg-zinc-900/60 backdrop-blur-md text-zinc-300 text-xs font-mono mb-6 inner-bevel"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
            ></span>
          </span>
          <span>{t.badge}</span>
        </div>

        <!-- Masked Headline with Kinetic Reveals -->
        <div class="hero-title mb-6">
          <h1
            class="text-3xl sm:text-5xl lg:text-[3.5rem] font-semibold tracking-[-0.035em] leading-[1.08] text-white"
          >
            <span class="mask-reveal">
              <span class="mask-reveal-inner">{t.titleLine1}</span>
            </span>
            <span class="mask-reveal">
              <span class="mask-reveal-inner text-zinc-400">{t.titleLine2}</span
              >
            </span>
          </h1>
        </div>

        <!-- Bio Description -->
        <p
          class="hero-desc text-sm sm:text-base text-zinc-400 max-w-xl leading-relaxed mb-8"
        >
          {t.bio1}
          <span class="text-zinc-100 font-medium">{t.bioName}</span>{t.bio2}
          <span class="text-zinc-200">{t.bioHighlights}</span>{t.bio3}
          <span class="text-zinc-200">{t.bioTools}</span>{t.bio4}
        </p>

        <!-- Actions Dock -->
        <div class="hero-cta flex flex-wrap items-center gap-3.5 mb-10">
          <a
            href="#projects"
            class="tactile-btn magnetic-btn group inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-zinc-100 text-zinc-950 font-medium text-xs sm:text-sm hover:bg-white shadow-lg transition-all"
          >
            <span>{t.ctaWork}</span>
            <svg
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="#contact"
            class="tactile-btn magnetic-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 bg-zinc-900/60 backdrop-blur-sm text-zinc-300 hover:text-white hover:bg-zinc-800 text-xs sm:text-sm font-medium transition-all"
          >
            <span>{t.ctaContact}</span>
          </a>

          <!-- Social links -->
          <div class="flex items-center gap-2 pl-2">
            <a
              href="https://github.com/xJuanes21"
              target="_blank"
              rel="noopener noreferrer"
              class="tactile-btn p-2.5 rounded-full border border-white/[0.08] bg-zinc-900/60 text-zinc-400 hover:text-white transition-colors"
              title="GitHub"
              aria-label="GitHub de Juan Esteban"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/juan-esteban-salazar-t-617449276"
              target="_blank"
              rel="noopener noreferrer"
              class="tactile-btn p-2.5 rounded-full border border-white/[0.08] bg-zinc-900/60 text-zinc-400 hover:text-white transition-colors"
              title="LinkedIn"
              aria-label="LinkedIn de Juan Esteban"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28"
                ></path>
              </svg>
            </a>
          </div>
        </div>

       
      </div>

      <!-- Right Column: Profile Portrait (Span 5) -->
      <div class="lg:col-span-5 hero-console relative">
        <div
          class="craft-card spotlight-card rounded-2xl overflow-hidden shadow-2xl border border-white/10 inner-bevel relative group"
        >
          <img
            src="/profile.png"
            alt="Juan Esteban Salazar Toro"
            class="w-full h-auto object-cover object-center aspect-[4/5] sm:aspect-[3/4] grayscale-[15%] group-hover:grayscale-0 transition-all duration-700 ease-out"
            loading="eager"
          />

          <!-- Overlay gradient to blend bottom edge -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#09090b]/90 via-[#09090b]/20 to-transparent opacity-80 pointer-events-none"
          >
          </div>

          <!-- Small tech badge overlay -->
          <div
            class="absolute bottom-6 left-6 right-6 flex items-center justify-between p-4 rounded-xl bg-black/40 backdrop-blur-md border border-white/[0.08] text-[11px] text-zinc-400 shadow-xl transform translate-y-2 group-hover:translate-y-0 transition-all duration-500"
          >
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"
                ></span>
              </span>
              <span class="text-zinc-200 font-medium font-mono"
                >{t.badgeDeploy}</span
              >
            </div>
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
