---
import SkillCarousel from "./SkillCarousel.astro";
import UnifiedCarousel from "./UnifiedCarousel.astro";
import { getI18n } from "../i18n/utils";

export interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const t = getI18n(lang).bentoSkills;
---

<section
  id="education"
  style="background-color: #0a101d;"
  class="stage-layer py-28 px-4 md:px-8 relative overflow-x-clip"
>
  <div class="max-w-5xl mx-auto w-full z-10 relative">
    <!-- Kinetic Section Divider Rule -->
    <div class="section-divider mb-12"></div>

    <!-- Section Header with Masked Reveal -->
    <div class="mb-16">
      <span
        class="font-mono text-xs text-sky-400/90 tracking-wider uppercase block mb-2"
      >
        {t.headerSub}
      </span>
      <h2
        class="text-2xl sm:text-4xl font-semibold tracking-[-0.025em] text-white mb-3"
      >
        <span class="mask-reveal">
          <span class="mask-reveal-inner">{t.headerTitle}</span>
        </span>
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl leading-relaxed">
        {t.headerDesc}
      </p>
    </div>

    <!-- ══ Skill Carousel Band ═══════════════════════════════════════════ -->
    <div class="mb-14">
      <span
        class="font-mono text-xs text-zinc-500 uppercase tracking-wider block mb-5"
      >
        {t.stackTitle}
      </span>
      <SkillCarousel />
    </div>

    <!-- ══ Education Carousel ═══════════════════════════════════════════ -->
    <div>
      <span class="font-mono text-xs text-zinc-500 uppercase tracking-wider block mb-8">
        {t.educationLabel}
      </span>

      <UnifiedCarousel itemsVisibleDesktop={1} autoPlay={false}>
        {t.degrees.map((deg: any) => (
          <div class="edu-card relative rounded-2xl overflow-hidden border border-white/[0.08] bg-[#0d1117]"
            style={`--deg-accent: ${deg.accentColor}`}
          >
            <!-- Top accent stripe -->
            <div class="absolute top-0 inset-x-0 h-px"
              style={`background: linear-gradient(90deg, transparent, ${deg.accentColor}60, transparent)`}
            ></div>
            <!-- Ambient top glow -->
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 rounded-full blur-3xl pointer-events-none"
              style={`background: ${deg.accentColor}12`}
            ></div>

            <div class="relative z-10 p-8 sm:p-10 flex flex-col gap-8">

              <!-- Header row -->
              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
                <!-- Left: institution + title -->
                <div class="flex gap-5 items-start">
                  <div>
                    <span class="text-[11px] font-mono tracking-[0.12em] uppercase block mb-1.5"
                      style={`color: ${deg.accentColor}99`}
                    >{deg.institution}</span>
                    <h3 class="text-xl sm:text-2xl font-semibold text-white tracking-tight leading-snug">{deg.title}</h3>
                    <p class="text-xs font-mono text-zinc-500 mt-1.5 flex items-center gap-1.5">
                      <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      {deg.location}
                    </p>
                  </div>
                </div>

                <!-- Right: graduated badge -->
                 <div class="shrink-0 flex flex-col items-center justify-center rounded-xl px-3 py-2 border"
                    style={`background: ${deg.accentColor}0f; border-color: ${deg.accentColor}28`}
                  >
                    <span class="font-mono font-bold text-2xl leading-none"
                      style={`color: ${deg.accentColor}`}
                    >{deg.year}</span>
                  </div>
              </div>

              <!-- Divider -->
              <div class="h-px w-full" style={`background: linear-gradient(90deg, ${deg.accentColor}30, rgba(255,255,255,0.04) 60%, transparent)`}></div>

              <!-- Description -->
              <p class="text-sm text-zinc-400 leading-[1.75] max-w-2xl">{deg.description}</p>

              <!-- Pillars grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                {deg.pillars.map((p: any) => (
                  <div class="group/pillar flex items-start gap-3 p-3.5 rounded-xl border border-white/[0.05] bg-white/[0.02] hover:border-white/[0.1] hover:bg-white/[0.04] transition-all duration-200">
                    <!-- Accent glyph -->
                    <span class="shrink-0 mt-0.5 text-[13px] font-mono font-bold" style={`color: ${deg.accentColor}80`}>→</span>
                    <div class="min-w-0">
                      <span class="font-mono text-[11px] font-semibold text-zinc-200 block mb-1 tracking-wide">{p.title}</span>
                      <p class="text-[11px] text-zinc-500 leading-relaxed">{p.desc}</p>
                    </div>
                  </div>
                ))}
              </div>

            </div>
          </div>
        ))}
      </UnifiedCarousel>
    </div>

  </div>
</section>
